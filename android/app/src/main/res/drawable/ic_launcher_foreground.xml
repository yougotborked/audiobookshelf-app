<?xml version="1.0" encoding="utf-8"?>
<!--
  Podshelf mark for the adaptive icon: headphones around a microphone built from shelf rails.

  The 64-grid master in design/podshelf-mark.svg, translated by (22, 23) to sit centred in the
  108dp adaptive viewport and inside the 72dp safe zone, so no launcher mask can clip it. The
  earcups are stadium outlines rather than rects, which VectorDrawable has no element for.

  A vector rather than the five PNG densities this replaced: one file, scales to the largest
  launcher, and the same paths serve the monochrome layer for themed icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- headband -->
    <path android:pathData="M32.5,54 A21.5,21.5 0 0 1 75.5,54" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <!-- earcups -->
    <path android:pathData="M27,59.5 A5.5,5.5 0 0 1 38,59.5 L38,65.5 A5.5,5.5 0 0 1 27,65.5 Z"
        android:strokeWidth="5.5" android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <path android:pathData="M70,59.5 A5.5,5.5 0 0 1 81,59.5 L81,65.5 A5.5,5.5 0 0 1 70,65.5 Z"
        android:strokeWidth="5.5" android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <!-- mic capsule, as shelf rails -->
    <path android:pathData="M50,45 H58" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <path android:pathData="M47,54 H61" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <path android:pathData="M50,63 H58" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <!-- stand, and the shelf it stands on -->
    <path android:pathData="M54,63 V74" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
    <path android:pathData="M44,74 H64" android:strokeWidth="5.5"
        android:strokeColor="#F0B457" android:strokeLineCap="round" />
</vector>
