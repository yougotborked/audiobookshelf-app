<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      required="true" stated rather than left to the default, which is already true. Play routes
      by this: a bundle without it is rejected from a wear: track with "APKs or Android App
      Bundles in this track must require the following features: android.hardware.type.watch",
      and a bundle with it is rejected from the phone track. It decides which track this
      artifact can go to, so it is worth being unambiguous about.
    -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!-- Standalone: the watch talks to the server itself rather than proxying the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 17 stopped letting INTERNET cover a private address. The watch streams and
      downloads from the same self-hosted server the phone does, which is usually on the user's
      own LAN, so without this the watch can reach the internet and not the one host it needs.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          false, because this watch app cannot be set up without the phone app.
          
          It said true, which conflated two different independences. The watch is independent of
          the phone on the *network*: it streams and downloads from the server directly rather
          than proxying audio through the phone, which is what the INTERNET and
          ACCESS_LOCAL_NETWORK permissions above are for. This flag is about something else -
          Google defines true as "all of its core functions, such as authentication, work
          locally on the watch".
          
          Nothing authenticates here. WearServerSession is never constructed on the watch, only
          received from the phone over the Data Layer, and with no session the UI says "Open
          Podshelf on your phone to send your queue here". A watch whose paired phone has no
          Podshelf would install this and find a screen it can never get past, which true
          invites Play to do.
          
          Flipping this back to true means giving the watch its own sign-in, not editing this
          line.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <service
            android:name=".player.WearPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Started by the Data Layer when the phone publishes, which is normally while this app
          is closed - so the queue is on disk before anyone raises their wrist.
        -->
        <service
            android:name=".sync.PhoneSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/podshelf" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
